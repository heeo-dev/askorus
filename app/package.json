{
  "name": "askorus",
  "version": "0.2.2",
  "main": "expo-router/entry",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "katex-fonts": "node scripts/katex-fonts.mjs",
    "licenses": "node scripts/licenses.mjs",
    "eas": "npx --yes eas-cli@25.3.0",
    "build:apk": "npx --yes eas-cli@25.3.0 build -p android --profile preview",
    "build:aab": "npx --yes eas-cli@25.3.0 build -p android --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|marked))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "**/src/**/*-test.[jt]s?(x)"
    ]
  },
  "dependencies": {
    "expo": "~58.0.24",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
