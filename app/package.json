{
  "name": "asksemble",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "eas": "npx --yes eas-cli@25.3.0",
    "build:apk": "npx --yes eas-cli@25.3.0 build -p android --profile preview",
    "build:aab": "npx --yes eas-cli@25.3.0 build -p android --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testMatch": [
      "**/src/**/*-test.[jt]s?(x)"
    ]
  },
  "dependencies": {
    "expo": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
